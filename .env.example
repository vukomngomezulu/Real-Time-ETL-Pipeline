# --- PostgreSQL (Docker) ---
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password
POSTGRES_DB=fraud_etl
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kafka (Docker) ---
# Use localhost:29092 only when running producer/consumer from the host.
# Docker Compose overrides app containers to use kafka:9092 internally.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_HOST_PORT=29092
KAFKA_TOPIC=transactions

# --- Simulation ---
TRANSACTIONS_PER_SECOND=2
FRAUD_INJECTION_RATE=0.05

# --- Dashboard ---
FLASK_SECRET_KEY=change-me-in-production
DASHBOARD_PORT=5000
